index 0000000..dd31f64
--- /dev/null
+++ b/crates/recursion/gnark-ffi/src/snarkrs.rs
@@ -0,0 +1,110 @@
+//! Groth16 proving with snarkrs in place of gnark's Go prover. The witness the Go side
+//! would read is solved by `snarkrs-gnark-solver` against `groth16_circuit.bin` and proved
+//! by `snarkrs-gnark` with `groth16_pk.bin` (gnark's `WriteDump`, as Go's `ReadDump` reads
+//! it), so the proof is one gnark's verifier and the Solidity verifier accept. The circuit
+//! is read once per process and the key streamed once to the GPU (`snarkrs-cuda`), on the
+//! first proof; the server's `CUDA_VISIBLE_DEVICES` makes its GPU device 0.
+
+use std::{
+    path::{Path, PathBuf},
+    sync::OnceLock,
+    time::Instant,
+};
+
+use snarkrs_field::{BigInteger, PrimeField};
+use snarkrs_gnark::{proof::write_proof, GnarkVerifyingKey, GnarkWitness};
+use snarkrs_gnark_solver::{
+    sp1::{parse_go_int, Witness},
+    GnarkR1cs, Solver,
+};
+use snarkrs_groth16::{PreparedCircuit, StageTimings};
+use crate::Groth16Bn254Proof;
+
+/// Bytes of `Proof.MarshalSolidity` without commitments: `Ar`, `Bs`, `Krs` raw.
+const SOLIDITY_PROOF_BYTES: usize = 8 * 32;
+
+struct Prover {
+    build_dir: PathBuf,
+    r1cs: GnarkR1cs,
+    solver: Solver,
+    circuit: Box<dyn PreparedCircuit>,
+}
+
+static PROVER: OnceLock<Prover> = OnceLock::new();
+
+impl Prover {
+    fn load(build_dir: &Path) -> anyhow::Result<Self> {
+        let t = Instant::now();
+        let r1cs = GnarkR1cs::read(&build_dir.join("groth16_circuit.bin"))?;
+        let vk = GnarkVerifyingKey::read(&build_dir.join("groth16_vk.bin"))?;
+        let circuit = snarkrs_cuda::gnark::prepare(0, &build_dir.join("groth16_pk.bin"), &vk)?;
+        tracing::info!(
+            "snarkrs: loaded {} on {} in {:?}",
+            build_dir.display(),
+            circuit.backend_name(),
+            t.elapsed()
+        );
+        Ok(Self { build_dir: build_dir.to_path_buf(), r1cs, solver: Solver::sp1(), circuit })
+    }
+}
+
+/// A 32-byte big-endian word, as `writeUint256` in `go/sp1/utils.go` writes it.
+fn uint256(s: &str) -> anyhow::Result<Vec<u8>> {
+    Ok(parse_go_int(s).map_err(anyhow::Error::msg)?.into_bigint().to_bytes_be())
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+/// Prove `witness_json` (a serialized [`crate::witness::GnarkWitness`]), returning the proof
+/// as `NewSP1Groth16Proof` in `go/sp1/utils.go` does. `groth16_vkey_hash` is left zero for
+/// the caller to set.
+pub fn prove(witness_json: &[u8], build_dir: &Path) -> anyhow::Result<Groth16Bn254Proof> {
+    let prover = match PROVER.get() {
+        Some(p) => p,
+        None => {
+            let p = Prover::load(build_dir)?;
+            PROVER.get_or_init(|| p)
+        }
+    };
+    anyhow::ensure!(
+        prover.build_dir == build_dir,
+        "snarkrs prover loaded {} but asked for {}",
+        prover.build_dir.display(),
+        build_dir.display()
+    );
+
+    let t = Instant::now();
+    let witness = Witness::from_json(witness_json).map_err(anyhow::Error::msg)?;
+    let (public, secret) = witness.assignment().map_err(anyhow::Error::msg)?;
+    let solution = prover.solver.solve(&prover.r1cs, &public, &secret)?;
+    let solved = t.elapsed();
+
+    let t = Instant::now();
+    let rows = GnarkWitness::from_parts(&solution.w, &solution.a, &solution.b)?;
+    let mut timings = StageTimings::default();
+    let proof =
+        snarkrs_gnark::prove(&*prover.circuit, &rows, &mut ark_std::rand::thread_rng(), &mut timings)?;
+    tracing::info!("snarkrs: solved in {solved:?}, proved in {:?}", t.elapsed());
+
+    let raw = write_proof(&proof);
+    let mut encoded = Vec::with_capacity(3 * 32 + SOLIDITY_PROOF_BYTES);
+    for s in [&witness.exit_code, &witness.vk_root, &witness.proof_nonce] {
+        encoded.extend(uint256(s)?);
+    }
+    encoded.extend_from_slice(&raw[..SOLIDITY_PROOF_BYTES]);
+
+    Ok(Groth16Bn254Proof {
+        public_inputs: [
+            witness.vkey_hash,
+            witness.committed_values_digest,
+            witness.exit_code,
+            witness.vk_root,
+            witness.proof_nonce,
+        ],
+        encoded_proof: hex(&encoded),
+        raw_proof: hex(&raw),
+        groth16_vkey_hash: [0; 32],
+    })
+}

+/// The guest outputs region of a serialized `JoltDevice` (postcard-encoded
+/// return value of the provable function).
+pub fn program_outputs(io_bytes: &[u8]) -> Result<Vec<u8>, String> {
+    let public_io: JoltDevice = decode(io_bytes, "program io")?;
+    Ok(public_io.outputs)
+}

+//! Trace the equinox guest natively (no proof): `trace-equinox <tier> [pdf]`.
+//! Without a PDF, a synthetic 393,722-byte buffer is used (enough for tier 2).
+#[path = "../src/engine.rs"]
+#[allow(dead_code)]
+mod engine;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let tier: u8 = args.get(1).map(|s| s.parse().unwrap()).unwrap_or(2);
+    let mut buf = match args.get(2) {
+        Some(p) => std::fs::read(p).unwrap(),
+        None => {
+            let mut v = b"%PDF-1.4\n".to_vec();
+            v.resize(393_722, 0x41);
+            v
+        }
+    };
+    buf.extend_from_slice(&[0u8; 16]);
+    let labels: Vec<String> = vec!["Energy".into(), "Protein".into()];
+    let mut inputs = postcard::to_allocvec(&tier).unwrap();
+    inputs.extend(postcard::to_allocvec(&buf.as_slice()).unwrap());
+    inputs.extend(postcard::to_allocvec(&labels).unwrap());
+    let public = std::path::Path::new("frontend/public");
+    let ctx = engine::ProverContext::new(
+        &std::fs::read(public.join("akita_schedules.bin")).unwrap(),
+        &std::fs::read(public.join("equinox_program.bin")).unwrap(),
+        &std::fs::read(public.join("equinox.elf")).unwrap(),
+    )
+    .unwrap();
+    let t = std::time::Instant::now();
+    let (cycles, max, panic, out) = engine::trace_only(&ctx, &inputs).unwrap();
+    let pp = &ctx.program_preprocessing;
+    println!("bytecode rows {}, bytecode_words {}, layout {:?}", pp.bytecode.bytecode.len(), pp.ram.bytecode_words.len(), pp.memory_layout);
+    println!("tier {tier}: cycles {cycles} (2^{:.2}), cap {max}, panic {panic}, out {} B, {:?}", (cycles as f64).log2(), out.len(), t.elapsed());
+}
+use jolt_inlines_sha2 as _;

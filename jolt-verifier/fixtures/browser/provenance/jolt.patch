+#[test]
+fn device_commit_matches_cpu_kernels() {
+    const D: usize = 512;
+    const POSITIONS: usize = 64;
+    let source = TracePackedOneHot::new(
+        16,
+        D,
+        8,
+        Arc::new(TestRows {
+            rows: 4096,
+            columns: 8,
+            k: 16,
+            committed_zero_column: Some(3),
+        }),
+    )
+    .unwrap();
+    let plan = CommitInnerPlan {
+        ring_dimension: D,
+        num_live_blocks: 16,
+        n_a: 2,
+        num_positions_per_block: POSITIONS,
+        num_digits_inner: 1,
+        log_basis_inner: 0,
+    };
+    let segment_rings = source.segment_ring_elems::<D>().unwrap();
+    let (_, num_blocks) = validate_block_geometry(segment_rings, 8, POSITIONS).unwrap();
+    let mut state = 0x9E37_79B9_7F4A_7C15u64;
+    let mut next = move || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    let a_rows = (0..plan.n_a)
+        .map(|_| {
+            (0..POSITIONS)
+                .map(|_| {
+                    CyclotomicRing::<AkitaField, D>::from_coefficients(std::array::from_fn(|_| {
+                        AkitaField::from_u128_reduced(u128::from(next()) << 64 | u128::from(next()))
+                    }))
+                })
+                .collect::<Vec<_>>()
+        })
+        .collect::<Vec<_>>();
+    let a_rows = a_rows.iter().map(Vec::as_slice).collect::<Vec<_>>();
+    let commit = |device: Option<&dyn TraceCommitDevice>| {
+        commit_packed_rows::<D>(&source, plan, &a_rows, segment_rings, num_blocks, device)
+            .unwrap()
+            .inner_rows
+    };
+
+    let cpu = commit(None);
+    assert_eq!(cpu.coeffs().len(), num_blocks * plan.n_a * D);
+    assert!(cpu
+        .coeffs()
+        .iter()
+        .any(|coefficient| !coefficient.is_zero()));
+    assert_eq!(commit(Some(&NaiveDevice { decline: false })), cpu);
+    assert_eq!(commit(Some(&NaiveDevice { decline: true })), cpu);
+    assert!(matches!(
+        commit_packed_rows::<D>(
+            &source,
+            plan,
+            &a_rows,
+            segment_rings,
+            num_blocks,
+            Some(&TruncatingDevice)
+        ),
+        Err(AkitaError::InvalidSize { .. })
+    ));
+}

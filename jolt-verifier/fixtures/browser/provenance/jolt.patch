+struct TruncatingDevice;
+
+impl TraceCommitDevice for TruncatingDevice {
+    fn commit_accumulate(&self, _job: &TraceCommitJob<'_>) -> Option<Result<Vec<u32>, AkitaError>> {
+        Some(Ok(Vec::new()))
+    }
+}

+struct NaiveDevice {
+    decline: bool,
+}
+
+impl TraceCommitDevice for NaiveDevice {
+    fn commit_accumulate(&self, job: &TraceCommitJob<'_>) -> Option<Result<Vec<u32>, AkitaError>> {
+        if self.decline {
+            return None;
+        }
+        let shape = job.shape;
+        let d = shape.ring_dimension;
+        let rows_per_ring = d / shape.one_hot_k;
+        let mut out = vec![AkitaField::zero(); shape.num_blocks * shape.n_a * d];
+        for row in 0..shape.num_rows {
+            let ring = row / rows_per_ring;
+            let trace_block = ring / shape.positions_per_block;
+            let position = ring % shape.positions_per_block;
+            for column in 0..shape.num_columns {
+                let hot = job.hot[row * shape.num_columns + column];
+                if hot == 0 && job.masks[row] >> column & 1 == 0 {
+                    continue;
+                }
+                let shift = (row % rows_per_ring) * shape.one_hot_k + usize::from(hot);
+                let block = column * shape.blocks_per_column + trace_block;
+                for a in 0..shape.n_a {
+                    let a_base = (a * shape.positions_per_block + position) * d;
+                    let out = &mut out[(block * shape.n_a + a) * d..][..d];
+                    for (i, out) in out.iter_mut().enumerate() {
+                        let limbs = &job.a_plane[(a_base + (i + d - shift) % d) * 4..][..4];
+                        let value = AkitaField::from_u128_checked(
+                            u128::from(limbs[0])
+                                | u128::from(limbs[1]) << 32
+                                | u128::from(limbs[2]) << 64
+                                | u128::from(limbs[3]) << 96,
+                        )
+                        .unwrap();
+                        if i >= shift {
+                            *out += value;
+                        } else {
+                            *out -= value;
+                        }
+                    }
+                }
+            }
+        }
+        Some(Ok(out
+            .iter()
+            .flat_map(|coefficient| {
+                let [lo, hi] = coefficient.to_limbs();
+                [lo as u32, (lo >> 32) as u32, hi as u32, (hi >> 32) as u32]
+            })
+            .collect()))
+    }
+}

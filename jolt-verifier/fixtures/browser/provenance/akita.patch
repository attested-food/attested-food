+    /// Every source's current values, concatenated.
+    pub(crate) fn source_values_bytes(&self, to_bytes: impl Fn(&E, &mut [u8])) -> Vec<u8> {
+        let total: usize = self.sources.iter().map(|s| s.values.len()).sum();
+        let mut out = vec![0u8; total * 16];
+        let mut slots = out.chunks_exact_mut(16);
+        for source in &self.sources {
+            for value in &source.values {
+                to_bytes(value, slots.next().expect("sized above"));
+            }
+        }
+        out
+    }

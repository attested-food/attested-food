DATABASE_URL=
RENDER_API_KEY=
# Deployer key for contracts/script/Deploy.s.sol.
PRIVATE_KEY=

# Frontend (Vite reads this root .env via envDir). 31337 = local anvil, 84532 = Base Sepolia.
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org
VITE_USD_ADDRESS=
VITE_FUND_ADDRESS=
# From https://cloud.reown.com — enables the WalletConnect option.
VITE_WC_PROJECT_ID=
# Shows the "Private key (testing only)" connect option.
VITE_ALLOW_PRIVATE_KEY=true
